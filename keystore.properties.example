# Copy to keystore.properties (git-ignored) and fill in your upload key details.
# Generate a key once with:
#   keytool -genkeypair -v -keystore gpstrack-upload-key.jks -alias gpstrack \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=gpstrack-upload-key.jks
storePassword=CHANGE_ME
keyAlias=gpstrack
keyPassword=CHANGE_ME
